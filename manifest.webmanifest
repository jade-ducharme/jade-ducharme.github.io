{"name":"Jade Marie Ducharme","short_name":"Jade Ducharme","description":"Jade Ducharme (Jade Marie Ducharme) is a Ph.D. candidate in physics at Brown University researching radio interferometry, 21-cm cosmology, and radio frequency interference mitigation with the Murchison Widefield Array. Publications, talks, and CV.","lang":"en","start_url":"/","background_color":"#111213","theme_color":"#1b1c1e","display":"minimal-ui","icons":[{"src":"icons/icon-48x48.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"48x48","type":"image/png"},{"src":"icons/icon-72x72.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"72x72","type":"image/png"},{"src":"icons/icon-96x96.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"96x96","type":"image/png"},{"src":"icons/icon-144x144.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"144x144","type":"image/png"},{"src":"icons/icon-192x192.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"192x192","type":"image/png"},{"src":"icons/icon-256x256.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"256x256","type":"image/png"},{"src":"icons/icon-384x384.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"384x384","type":"image/png"},{"src":"icons/icon-512x512.png?v=0706fb111d73a979bba6a6ff793cc7ee","sizes":"512x512","type":"image/png"}]}