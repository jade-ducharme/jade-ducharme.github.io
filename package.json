{
  "name": "jade-ducharme-site",
  "description": "Personal academic website for Jade Marie Ducharme",
  "version": "1.0.0",
  "author": "Jade Marie Ducharme <jade_ducharme@brown.edu>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jade-ducharme/jade-ducharme.github.io"
  },
  "keywords": [
    "gatsby",
    "radio-astronomy",
    "cosmology"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0 <26.0.0"
  },
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby build && gh-pages -d public -b gh-pages",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "babel-plugin-styled-components": "^2.3.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "lodash": "^4.18.1",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-transition-group": "^4.4.5",
    "smooth-scroll": "^16.1.3",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@upstatement/prettier-config": "^1.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "gatsby-remark-code-titles": "^1.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  }
}
